{
  "name": "@tgslots/simulations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'Nothing to build for simulations'",
    "woodland-whisper": "bun run woodland-whisper.ts",
    "woodland-whisper:par": "bun run woodland-whisper.ts --workers 0",
    "woodland-whisper:verify": "bun run woodland-whisper.ts --mode verify --spins 20M",
    "woodland-whisper:verify:par": "bun run woodland-whisper.ts --mode verify --spins 1B --workers 0",
    "ancient-dragon": "bun run ancient-dragon.ts",
    "ancient-dragon:par": "bun run ancient-dragon.ts --workers 0",
    "ancient-dragon:verify": "bun run ancient-dragon.ts --mode verify --spins 20M",
    "ancient-dragon:verify:par": "bun run ancient-dragon.ts --mode verify --spins 1B --workers 0"
  },
  "dependencies": {
    "@tgslots/math": "workspace:*",
    "@tgslots/slots-core": "workspace:*",
    "@tgslots/slots-simulation-engine": "workspace:*",
    "@tgslots/woodland-whisper": "workspace:*",
    "@tgslots/ancient-dragon": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
